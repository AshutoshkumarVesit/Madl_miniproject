<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: AMOLED-optimized deep navy -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0A0E1A"
                android:centerColor="#0F131F"
                android:endColor="#171B28"
                android:angle="270" />
        </shape>
    </item>
    <!-- Subtle cyan glow from center -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0800E5FF"
                android:centerColor="#0500E5FF"
                android:endColor="#00000000"
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="0.5"
                android:centerY="0.35" />
        </shape>
    </item>
</layer-list>
