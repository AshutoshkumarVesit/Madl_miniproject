<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".MainActivity">

    <org.osmdroid.views.MapView
        android:id="@+id/mapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/statsOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_panel"
        android:padding="16dp"
        android:layout_margin="16dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_surface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/statDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 km"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/color_on_surface"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/statPace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00 /km"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/color_on_surface"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/statCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 kcal"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/color_on_surface" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="16dp"
        android:background="@drawable/bg_panel"
        android:padding="12dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/runControlButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Run"
            android:textAllCaps="false"
            android:backgroundTint="@color/color_primary"
            android:textColor="@color/color_on_primary" />

        <Button
            android:id="@+id/stopRunButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop Run"
            android:textAllCaps="false"
            android:layout_marginStart="12dp"
            android:backgroundTint="@color/color_surface"
            android:textColor="@color/color_on_surface" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
