<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/color_surface_container_low">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/bestIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_nav_stats"
            android:padding="4dp"
            android:background="@drawable/bg_glass_card"
            app:tint="@color/color_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/bestTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 Kilometers"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface" />

            <TextView
                android:id="@+id/bestSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sep 10, 2024"
                android:textSize="12sp"
                android:textColor="@color/color_on_surface_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/bestValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="26:01"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
