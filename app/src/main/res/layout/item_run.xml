<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/color_surface_container_low">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/runName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Morning Run"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface" />

            <TextView
                android:id="@+id/runDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-03-15"
                android:textSize="12sp"
                android:textColor="@color/color_on_surface_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/runDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 km"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/color_primary"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/runDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface_secondary" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
