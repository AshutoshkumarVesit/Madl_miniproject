<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MoveMate" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/color_primary_light</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSecondaryContainer">@color/color_secondary_container</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/color_tertiary</item>
        <item name="colorTertiaryContainer">@color/color_tertiary_container</item>

        <!-- Surface & Background -->
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_secondary</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:navigationBarColor">@color/color_nav_surface</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Error -->
        <item name="colorError">@color/color_error</item>
        <item name="colorErrorContainer">@color/color_error_container</item>

        <!-- Outline -->
        <item name="colorOutline">@color/color_outline</item>
        <item name="colorOutlineVariant">@color/color_outline_variant</item>

        <!-- Text -->
        <item name="android:textColorHint">@color/color_on_surface_secondary</item>

        <!-- Styles -->
        <item name="buttonStyle">@style/Widget.MoveMate.Button</item>
        <item name="checkboxStyle">@style/Widget.MoveMate.Checkbox</item>
        <item name="bottomNavigationStyle">@style/Widget.MoveMate.BottomNav</item>
    </style>

    <style name="Widget.MoveMate.Button" parent="@style/Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:backgroundTint">@color/color_primary</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.MoveMate.Button.Gradient" parent="@style/Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_gradient_button</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.MoveMate.Checkbox" parent="@style/Widget.Material3.CompoundButton.CheckBox" />

    <style name="Widget.MoveMate.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/color_surface</item>
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
    </style>

    <!-- Text appearances -->
    <style name="TextAppearance.MoveMate.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MoveMate.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MoveMate.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.MoveMate.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/color_on_surface_secondary</item>
    </style>

    <style name="TextAppearance.MoveMate.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/color_on_surface_secondary</item>
    </style>
</resources>
